{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-design-chatgpt",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare's git builds run a bare `wrangler deploy`, so build the client, view and worker here.
  "build": { "command": "pnpm build:view && vite build" },
  "assets": {
    // Vite plugin v2 emits the client here; legacy Workers Builds still invoke Wrangler.
    "directory": "./.cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything the OAuth provider owns must reach the Worker, or the SPA
    // fallback would answer index.html to a token request.
    "run_worker_first": [
      "/api/*",
      "/ws/*",
      "/mcp",
      "/authorize",
      "/github/*",
      "/oauth/*",
      "/.well-known/oauth-*",
      "/.well-known/openai-apps-challenge",
    ],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "DiagramRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiagramRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-design-chatgpt",
      "database_id": "44457e48-2445-4405-abc3-f5b514c6bee5",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "system-design-chatgpt" }],
  // Dedicated production OAuth tokens and codes. Preview uses a separate namespace.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "ef2283e33e7d45398b5dc7db2a212e6e",
    },
  ],
  "observability": { "enabled": true },
  // Branch builds run `wrangler preview`. Each Preview gets its own Durable Object storage;
  // D1 and R2 point at shared preview resources so previews never touch production data.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "DiagramRoom" }] },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "system-design-chatgpt-preview",
        "database_id": "c30f0c8e-3349-42c4-a976-e3e5601cd295",
      },
    ],
    "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "system-design-chatgpt-preview" }],
    "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0826131f4f664cc4a793411a263ef106" }],
  },
}
